{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },

        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 32"
        },

        "communityName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },

        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },

        "avatarUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },

        "bannerUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },

        "avatarBase64": {
          ".validate": "newData.isString() && newData.val().length <= 900000"
        },

        "bannerBase64": {
          ".validate": "newData.isString() && newData.val().length <= 900000"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "paragraphsCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "tekersCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "tekingCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "shaabiyaScore": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },

        "totalEngagementScore": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },

        "verified": {
          ".validate": "newData.isBoolean()"
        },

        "fcmToken": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 4096"
        },

        "language": {
          ".validate": "newData.isString() && (newData.val() === 'ar' || newData.val() === 'en')"
        },

        "accountStatus": {
          ".validate": "newData.isString() && (newData.val() === 'ACTIVE' || newData.val() === 'DEACTIVATED')"
        },

        "twoFactorEnabled": {
          ".validate": "newData.isBoolean()"
        },

        "categories": {
          ".validate": "newData.hasChildren() || newData.val() == null"
        },

        "socialLinks": {
          ".validate": "newData.hasChildren() || newData.val() == null"
        },

        "customButtons": {
          ".validate": "newData.hasChildren() || newData.val() == null"
        },

        "pinnedPostId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "isPrivateRoom": {
          ".validate": "newData.isBoolean()"
        },

        "hideLastSeen": {
          ".validate": "newData.isBoolean()"
        },

        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },

        "whoCanComment": {
          ".validate": "newData.isString() && (newData.val() === 'EVERYONE' || newData.val() === 'TEKERS' || newData.val() === 'NOBODY')"
        }
      }
    },

    "usernames": {
      ".read": true,

      "$username": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length > 0"
      }
    },

    "posts": {
      ".read": true,

      ".indexOn": [
        "createdAt",
        "shaabiyaScore",
        "authorId",
        "threadId"
      ],

      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid))",

        ".validate": "newData.hasChildren(['postId','authorId','content','createdAt'])",

        "postId": {
          ".validate": "newData.isString() && newData.val() === $postId"
        },

        "authorId": {
          ".validate": "newData.isString() && newData.val() === (data.exists() ? data.child('authorId').val() : auth.uid)"
        },

        "authorUsername": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },

        "authorAvatarUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },

        "authorAvatarBase64": {
          ".validate": "newData.isString() && newData.val().length <= 900000"
        },

        "content": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "imageBase64": {
          ".validate": "newData.isString() && newData.val().length <= 900000"
        },

        "likesCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "dislikesCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "commentsCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "teksCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "shaabiyaScore": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },

        "isTek": {
          ".validate": "newData.isBoolean()"
        },

        "originalPostId": {
          ".validate": "newData.val() == null || newData.isString()"
        },

        "originalAuthorId": {
          ".validate": "newData.val() == null || newData.isString()"
        },

        "originalAuthorUsername": {
          ".validate": "newData.val() == null || newData.isString()"
        },

        "backgroundColor": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },

        "emoji": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val() === '🔥' || newData.val() === '💬' || newData.val() === '✨')"
        },

        "textColor": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },

        "textBold": {
          ".validate": "newData.isBoolean()"
        },

        "textUnderline": {
          ".validate": "newData.isBoolean()"
        },

        "textBackgroundColor": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },

        "links": {
          ".validate": "newData.hasChildren() || newData.val() == null"
        },

        "customHtml": {
          ".validate": "newData.isString() && newData.val().length <= 10000"
        },

        "privacy": {
          ".validate": "newData.isString() && (newData.val() === 'PUBLIC' || newData.val() === 'PRIVATE' || newData.val() === 'LIMITED' || newData.val() === 'CUSTOM')"
        },

        "allowedViewerIds": {
          ".validate": "newData.hasChildren() || newData.val() == null"
        },

        "scheduledAt": {
          ".validate": "newData.val() == null || newData.isNumber()"
        },

        "isPinned": {
          ".validate": "newData.isBoolean()"
        },

        "replyCommentId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "replyCommentAuthorId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "replyCommentAuthorUsername": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },

        "replyCommentContent": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },

        "threadId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "threadPreviousPostId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "threadPosition": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "comments": {
      "$postId": {
        ".read": true,
        ".indexOn": ["createdAt"],

        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid))",

          ".validate": "newData.hasChildren(['commentId','postId','authorId','content','createdAt'])",

          "commentId": {
            ".validate": "newData.isString() && newData.val() === $commentId"
          },

          "postId": {
            ".validate": "newData.isString() && newData.val() === $postId"
          },

          "authorId": {
            ".validate": "newData.isString() && newData.val() === (data.exists() ? data.child('authorId').val() : auth.uid)"
          },

          "authorUsername": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },

          "authorAvatarUrl": {
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },

          "authorAvatarBase64": {
            ".validate": "newData.isString() && newData.val().length <= 500000"
          },

          "content": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          },

          "createdAt": {
            ".validate": "newData.isNumber()"
          },

          "likesCount": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },

          "parentCommentId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },

          "replyToUsername": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          }
        }
      }
    },

    "reactions": {
      "$postId": {
        ".read": true,

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && (newData.val() === 'LIKE' || newData.val() === 'DISLIKE')"
        }
      }
    },

    "userReactions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$postId": {
          ".validate": "newData.isString() && (newData.val() === 'LIKE' || newData.val() === 'DISLIKE')"
        }
      }
    },

    "commentLikes": {
      "$commentId": {
        ".read": true,

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },

    "userCommentLikes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$commentId": {
          ".validate": "newData.val() === true"
        }
      }
    },

    "teking": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",

        "$targetUid": {
          ".validate": "newData.val() === true"
        }
      }
    },

    "tekers": {
      "$uid": {
        ".read": true,

        "$followerUid": {
          ".write": "auth != null && (auth.uid === $followerUid || auth.uid === $uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "$targetUid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },

    "blockedBy": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "$blockerUid": {
          ".write": "auth != null && auth.uid === $blockerUid",
          ".validate": "newData.val() === true"
        }
      }
    },

    "userSecrets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "twoFactorPinHash": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        }
      }
    },

    "settings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "language": {
          ".validate": "newData.isString() && (newData.val() === 'ar' || newData.val() === 'en')"
        }
      }
    }
  }
}
